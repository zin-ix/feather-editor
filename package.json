{
  "name": "feather-editor-vue",
  "version": "1.2.4",
  "publishConfig": {
    "access": "public"
  },
  "description": "A lightweight, zero-dependency rich text editor with clean Feather icons. Framework-agnostic, headless by design.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./vue": {
      "types": "./types/vue.d.ts",
      "default": "./adapters/vue/index.js"
    },
    "./web-component": {
      "types": "./types/web-component.d.ts",
      "default": "./adapters/web-component/feather-editor.js"
    },
    "./styles": "./styles/feather.css",
    "./styles/feather.css": "./styles/feather.css",
    "./collab": {
      "types": "./types/collab.d.ts",
      "default": "./collab/index.js"
    },
    "./collab/*": "./collab/*",
    "./server/*": "./server/*"
  },
  "bin": "./bin/cli.js",
  "files": [
    "src/",
    "adapters/",
    "styles/",
    "template/",
    "bin/",
    "feather.config.js",
    "collab/",
    "server/",
    "types/"
  ],
  "keywords": [
    "rich-text-editor",
    "feather-editor",
    "feather",
    "vue",
    "vue3",
    "vue-rich-text-editor",
    "rte",
    "wysiwyg",
    "contenteditable",
    "editor",
    "headless",
    "zero-dependency"
  ],
  "author": "Feather (https://feathereditor.dev)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feather-editor.git"
  },
  "homepage": "https://runeditor.com",
  "bugs": {
    "url": "https://github.com/feather-editor/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm test",
    "test:e2e": "node tests/e2e/collab-ime.mjs && node tests/e2e/collab-persistence.mjs && node tests/e2e/collab-suggestions.mjs",
    "collab-server": "node server/collab-server.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.8.3",
    "playwright-core": "^1.60.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.42",
    "ws": "^8.21.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  },
  "peerDependencies": {
    "vue": ">=3.2",
    "ws": "^8.0.0",
    "y-indexeddb": "^9.0.0",
    "y-protocols": "^1.0.0",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "y-indexeddb": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "y-websocket": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  }
}
